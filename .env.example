# Password untuk membuka dashboard (wajib)
DASHBOARD_PASSWORD=
# Kata rahasia untuk pemicu per menit (wajib supaya komentar otomatis jalan tanpa dashboard terbuka)
CRON_SECRET=
# Token akses dari Meta for Developers
IG_ACCESS_TOKEN=
# ID akun Instagram (angka) dari halaman Meta. Wajib untuk token "Unified login" / system user.
IG_USER_ID=
# Diisi otomatis saat menambahkan database Neon dari tab Storage di Vercel
DATABASE_URL=

# Opsional
# TEST_ACCOUNTS=sakatimepiece      # akun uji (pisahkan dengan koma): komentar "Tes, 300" dari akun ini menjadi bid bohongan untuk menguji alur DM
# IG_MOCK=1                      # mode demo dengan data palsu, tidak mengirim apa pun ke Instagram
# SNIPER_MIN_BIDS=2               # Sniper Zone otomatis hanya dikirim kalau bid sah minimal sebanyak ini (0 = selalu kirim)
# AUTO_REPLY_MAX_PER_HOUR=40        # batas balasan otomatis per jam
# AUTO_REPLY_TEXT=bid {total} sah yaa
# AUTO_DM_TEXT=Menang yaa untuk lelang {barang} di harga {harga} 🥳 {tautan}   # isi DM ke pemenang; {barang}, {harga}, dan {tautan} (alamat postingan) diisi otomatis
# AUTO_RESULT_GRACE_SEC=15         # jeda setelah close sebelum pemenang bawaan ditetapkan (menunggu komentar telat terbaca)
# AUTO_DM_DELAY_SEC=10             # jeda (detik) setelah pemenang ditetapkan sebelum DM otomatis dikirim; 0 untuk langsung
# IG_MESSAGES_ID=                  # hanya kalau Meta meminta ID Halaman (bukan ID akun Instagram) untuk mengirim DM
# TEN_TEXT=10 MENIT MENUJU CLOSE!
# SNIPER_TEXT=🎯 SNIPER ZONE! 🎯
# CLOSE_TEXT=❌ LELANG CLOSED! ❌
# IG_API_BASE=https://graph.instagram.com
# IG_API_VERSION=
